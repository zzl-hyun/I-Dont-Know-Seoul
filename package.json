    "@vitejs/plugin-react": "^5.0.0",
    "mapshaper": "^0.6.102",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.86.0"

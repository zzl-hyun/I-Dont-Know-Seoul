# 이 파일을 .env 로 복사하고 값을 채우세요. (.env 는 .gitignore 로 제외됩니다)
#
#   cp .env.example .env

# 공공데이터포털 — 소상공인 상가업소 + 국토교통부 전월세 실거래가
# (단독/다가구 + 오피스텔 + 아파트)
#
# 반드시 "일반 인증키(Decoding)" 값을 넣을 것.
# %2B, %3D 가 들어간 Encoding 값을 넣으면 스크립트가 다시 URL 인코딩해서
# 이중 인코딩이 되고 모든 요청이 인증에 실패한다.
DATA_GO_KR_KEY=

# 서울 열린데이터광장
#
# 파이프라인 자체에는 쓰이지 않는다 — 치안 축에 넣으려던 "안심이 CCTV 연계
# 현황"(OA-20923)이 2026-02-10 자로 폐기됐다. 새 CCTV 데이터셋을 붙일 때를
# 대비해 남겨둔다. (5대범죄·교통사고 다발지역은 이 키가 필요 없다 —
# data.go.kr CSV 스냅샷이라 data/raw/ 에 커밋되어 있다.)
#
# `scripts/calibrate-walk.mjs --source=seoul` (일회성 검증 스크립트, 파이프라인
# 아님)은 이 키로 서울시 도보 네트워크(TbTraficWlkNet)를 받아 WALK_DETOUR_FACTOR
# 를 교차검증한다.
SEOUL_OPEN_DATA_KEY=

# ─────────────────────────────────────────────────────────────
# Kakao REST 키는 여기 넣지 말 것.
# 브라우저에 노출되면 안 되므로 Worker Secret 으로 관리한다:
#
#   npx wrangler secret put KAKAO_REST_KEY
#
# 발급 후 Kakao Developers → 제품 설정 → 카카오맵 → 활성화 설정 ON 필요.
# ─────────────────────────────────────────────────────────────

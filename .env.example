# 이 파일을 .env 로 복사하고 값을 채우세요. (.env 는 .gitignore 로 제외됩니다)
#
#   cp .env.example .env

# 공공데이터포털 — 소상공인 상가업소 + 국토교통부 전월세 실거래가
# (단독/다가구 + 오피스텔 + 아파트) + 경기 GBIS 버스 기반정보
#
# 반드시 "일반 인증키(Decoding)" 값을 넣을 것.
# %2B, %3D 가 들어간 Encoding 값을 넣으면 스크립트가 다시 URL 인코딩해서
# 이중 인코딩이 되고 모든 요청이 인증에 실패한다.
DATA_GO_KR_KEY=

# 서울 열린데이터광장
#
# `scripts/prepare-bus-network.mjs`가 서울 버스 경유정류소(`busRteInfo`)를
# 받을 때 사용한다. 치안 축의 "안심이 CCTV 연계 현황"(OA-20923)은
# 2026-02-10 폐기되어 이 키로도 받을 수 없다.
#
# `scripts/calibrate-walk.mjs --source=seoul` (일회성 검증 스크립트, 파이프라인
# 아님)은 이 키로 서울시 도보 네트워크(TbTraficWlkNet)를 받아 WALK_DETOUR_FACTOR
# 를 교차검증한다.
SEOUL_OPEN_DATA_KEY=

# 한국부동산원 부동산통계정보(R-ONE) — 파이프라인 아님, 검증 전용
#
# `scripts/crosscheck-rent.mjs`가 우리 월세 중앙값을 외부 기준과 대조할 때만
# 쓴다. R-ONE은 시군구가 최소 공표 단위라 행정동 지표를 대체할 수 없다.
# 대신 표본이 민간 임대차 중심이라 공공임대 왜곡이 없어서, 우리가 공공임대를
# 제대로 걸러냈는지 확인하는 기준지로 쓴다.
#
# 키가 없으면 응답이 5건 샘플로 잘린다(오류가 아니라 조용히 잘린다).
REB_API_KEY=

# ─────────────────────────────────────────────────────────────
# Kakao REST 키는 여기 넣지 말 것.
# 브라우저에 노출되면 안 되므로 Worker Secret 으로 관리한다:
#
#   npx wrangler secret put KAKAO_REST_KEY
#
# 발급 후 Kakao Developers → 제품 설정 → 카카오맵 → 활성화 설정 ON 필요.
# ─────────────────────────────────────────────────────────────

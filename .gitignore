node_modules
.wrangler/
*.local

# API 키. 저장소가 공개되어 있으므로 절대 커밋하지 말 것.
# 파이프라인 키는 .env, Worker 키는 `wrangler secret put` 으로 관리한다.
.env
.env.*
!.env.example
.dev.vars

# 빌드 산출물. 앞의 "/"가 없으면 data/dist/ 까지 함께 무시되어,
# 파이프라인 산출물이 빠지고 클론한 저장소에서 테스트가 깨진다.
/dist/

# 원본 공공데이터 — 용량이 크고(50MB+) 스크립트로 다시 받을 수 있으므로 커밋하지 않는다.
# 반면 가공 산출물(data/dist/)은 커밋한다. 테스트와 앱이 직접 읽고,
# 파이프라인을 돌리지 않아도 바로 실행할 수 있어야 하기 때문이다.
#
# "data/raw/*" 로 쓴 이유: "data/raw/" 처럼 디렉토리 자체를 지우면 그 안의
# 파일을 아래 "!" 로 다시 못 살린다(git의 제약 — 부모 디렉토리가 제외되면
# 그 안의 파일은 재포함 규칙이 안 먹는다). 와일드카드로 내용물 각각을
# 지워야 파일 단위 예외가 동작한다.
data/raw/*

# 예외: 대상 지역분만 추출한 작은 정적 스냅샷. 연 1회 갱신되는 파일데이터라
# 스크립트가 자동으로 다시 받을 수 없어(로그인·수동 다운로드), 재현성을 위해
# 커밋한다. 전국 원본에서 서울 25개 자치구 + 경기 3개 시(수원·성남·용인)만
# 뽑은 UTF-8 파생 파일이다 — 원본은 CP949 에 수십 MB라 그대로 안 넣는다.
# 교통사고만 지점 단위라 565KB 이고 나머지 둘은 각 수 KB.
!data/raw/police-crime-*.csv
!data/raw/population-*.csv
!data/raw/traffic-accident-hotspots-*.csv
# 격자 인구: 기존 1km 스냅샷만 재현성 때문에 유지한다. SGIS 100m 자료는
# 승인받은 원자료에 가까워 커밋하지 않고, 공개 번들에는 동별 최대 24개 대표
# 프로필과 정규화 가중치로 비가역 집약한 결과만 포함한다.
!data/raw/grid-population-2024.json

.DS_Store
*.log

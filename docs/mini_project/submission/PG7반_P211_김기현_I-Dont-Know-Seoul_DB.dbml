// =====================================================================
// I Don't Know Seoul — D1 데이터 모델
// PG7반 {개인별코드} {이름} · v2.0
//
// 이 파일은 Cloudflare D1(SQLite)의 영속 데이터만 모델링한다.
// 화면에 필요한 행정동 지표·경계·교통망까지 모두 관계형 테이블로 복제하지
// 않는다. 화면에서 쓰는 값의 저장 위치는 Project Note에 고정한다.
// =====================================================================

Project I_Dont_Know_Seoul {
  database_type: "SQLite"

  Note: '''
    D1/SQLite에 저장하는 테이블은 정확히 regions, users, oauth_accounts,
    sessions, destinations, reviews, review_helpfuls 일곱 개다.

    Cloudflare KV 번들 범위(ERD 밖): 행정동 경계, 공공데이터 원지표와
    백분위/점수, 지하철·버스 교통망 그래프, 일반 지오코딩 검색 캐시.
    브라우저는 KV 번들을 받아 통근시간·점수·추천·공유 URL을 계산한다.
    destinations는 일반 검색 캐시가 아니라 후기와 연결된 목적지의 이름,
    주소, 좌표만 보관한다.

    최종 설계의 대상은 547개 행정동이다. 현재 구현 번들이 제공하는 556개와
    차이가 있어도 D1 테이블을 확장하는 근거로 삼지 않는다. 구현 데이터와
    제출 설계 모집단은 후속 동기화 대상이다.

    모든 시각은 SQLite에서 비교 가능한 ISO-8601 TEXT이며 API가 UTC 기준으로
    기록한다. D1은 직접 GRANT를 애플리케이션 권한으로 사용하지 않고 서버 API가
    세션과 작성자 소유권을 검사한다. 별도로 지정하지 않은 FK 삭제 동작은
    SQLite 기본 NO ACTION이다.

    API↔DB 필드 매핑은 다음과 같다. API의 destination.name/address/lat/lng는
    destinations.place_name/address/lat/lng로, residenceMonths는
    reviews.residence_months로, feltCommuteMin은 reviews.felt_commute_min으로,
    ratings.safety/price/convenience는 reviews.rating_safety/
    rating_price/rating_convenience로 변환한다. helpfulCount는
    review_helpfuls의 COUNT(*)이고 helpfulByMe는 현재 세션 회원의 반응 행
    존재 여부, isMine은 reviews.user_id와 현재 세션 회원 ID의 비교 결과다.
    이 세 값은 계산·직렬화 값이며 컬럼을 추가하지 않는다.

    통근 목적지는 후기 생성에 필수다. POST는 전용 destinations snapshot과
    reviews를 한 트랜잭션에서 함께 생성한다. destinations 행은 후기에만
    속하는 snapshot이고 공유하지 않으므로 reviews.destination_id에는 unique
    index를 둔다. PATCH는 작성자 본인 후기의 전용 snapshot만 갱신하거나 새
    snapshot으로 교체하고 이전 snapshot을 같은 트랜잭션에서 정리한다.
    DELETE는 reviews 삭제로 review_helpfuls를 cascade 처리한 뒤 연결된
    destinations를 같은 트랜잭션에서 삭제한다. FK 방향상 destination 삭제는
    자동 cascade가 아니라 이 API 트랜잭션 정책으로 고아 행을 방지한다.
  '''
}

// ------------------------------------------------------------- 행정동 참조
Table regions {
  code     text [pk, not null, note: '행정동 코드. 후기 조회 경로의 기준 키 (REQ-FUNC-012, REQ-FUNC-013, REQ-FUNC-014)']
  name     text [not null, note: '후기 목록에 표시할 행정동명 (REQ-FUNC-012)']
  district text [not null, note: '상위 자치구/지역명. 후기 화면의 지역 맥락 표시용 최소 참조값 (REQ-FUNC-012)']

  indexes {
    (district, name) [name: 'idx_regions_district_name']
  }

  Note: '후기 FK가 참조하는 최소 마스터다. 경계 geometry, 중심좌표, 면적, 지표, 점수, 역 연결은 KV 번들이므로 저장하지 않는다. 최종 설계 기준은 547개이며 구현의 556개 차이는 동기화 대상이다.'
}

// ------------------------------------------------------------- 익명 회원
Table users {
  id         integer [pk, increment, not null, note: 'D1 INTEGER PRIMARY KEY 식별자 (REQ-FUNC-011)']
  nickname   text    [not null, note: '후기에 노출하는 익명 닉네임. UID 기반 생성값이며 1~12자 범위는 API가 검증한다 (REQ-FUNC-011, REQ-FUNC-012, REQ-NFN-004)']
  created_at text    [not null, default: `CURRENT_TIMESTAMP`, note: '회원 레코드 생성 시각 (REQ-FUNC-011)']

  Note: '이메일, 실명, 프로필 사진, 비밀번호, OAuth access token/refresh token은 저장하지 않는다 (REQ-NFN-003, REQ-NFN-004). 공개 후기 API는 nickname만 투영한다.'
}

// ------------------------------------------------------------- OAuth 계정 연결
Table oauth_accounts {
  id                integer [pk, increment, not null]
  user_id           integer [not null, note: 'users.id. 한 회원이 연결한 OAuth 계정의 소유자 (REQ-FUNC-011, REQ-NFN-003)']
  provider          text    [not null, note: 'kakao 또는 github만 허용. 허용값은 API가 검증한다 (REQ-FUNC-011)']
  provider_user_id  text    [not null, note: 'OAuth 제공자의 비공개 계정 식별자. 토큰 원문이 아님 (REQ-FUNC-011, REQ-NFN-003, REQ-NFN-004)']
  created_at        text    [not null, default: `CURRENT_TIMESTAMP`, note: '연결 생성 시각']

  indexes {
    (provider, provider_user_id) [unique, name: 'uq_oauth_accounts_provider_user']
    (user_id, provider) [unique, name: 'uq_oauth_accounts_user_provider']
  }

  Note: '같은 provider/provider_user_id로 중복 계정을 만들지 않는다. 필요하면 한 users에 provider별 계정 하나만 연결한다. OAuth access/refresh token과 제공자 전체 프로필은 저장하지 않는다.'
}

// ------------------------------------------------------------- HttpOnly 세션
Table sessions {
  id         integer [pk, increment, not null]
  user_id    integer [not null, note: 'users.id. 세션 소유 회원 (REQ-FUNC-011, REQ-NFN-003)']
  token_hash text    [not null, note: '원문 세션 토큰의 단방향 해시만 저장. 원문 쿠키값은 D1에 저장하지 않는다 (REQ-NFN-003, REQ-NFN-004)']
  expires_at text    [not null, note: '만료 시각. 만료 세션 정리/조회 인덱스 기준 (REQ-FUNC-011, REQ-NFN-003)']
  created_at text    [not null, default: `CURRENT_TIMESTAMP`, note: '세션 발급 시각']

  indexes {
    (token_hash) [unique, name: 'uq_sessions_token_hash']
    (expires_at) [name: 'idx_sessions_expires_at']
    (user_id, expires_at) [name: 'idx_sessions_user_expires']
  }

  Note: 'auth/me와 로그아웃은 token_hash로 현재 세션을 찾고 expires_at을 확인한다. HttpOnly/Secure/SameSite 쿠키 설정은 API 런타임 정책이며 D1 컬럼이 아니다.'
}

// ------------------------------------------------------------- 후기 연결 목적지
Table destinations {
  id         integer [pk, increment, not null]
  place_name text    [not null, note: '후기에 표시할 목적지명 (REQ-FUNC-012, REQ-FUNC-013)']
  address    text    [not null, note: '후기에 표시할 목적지 주소 (REQ-FUNC-002, REQ-FUNC-012, REQ-FUNC-013)']
  lng        real    [not null, note: '경도 -180..180. 후기와 연결된 좌표이며 일반 검색 캐시가 아님 (REQ-FUNC-002, REQ-FUNC-013)']
  lat        real    [not null, note: '위도 -90..90. 후기와 연결된 좌표이며 일반 검색 캐시가 아님 (REQ-FUNC-002, REQ-FUNC-013)']
  created_at text    [not null, default: `CURRENT_TIMESTAMP`, note: '후기 연결 목적지 생성 시각']

  Note: '일반 지오코딩 결과의 query/cached_at 또는 검색 이력은 저장하지 않는다. 일반 지오코딩 캐시는 KV geo:v2 영역이며, 이 테이블은 후기에서 참조되는 목적지 좌표만 보관한다. 각 행은 하나의 후기만을 위한 전용 snapshot이며 다른 후기와 공유하지 않는다. 후기 생성 시 reviews와 함께 생성하고, 작성자 후기의 PATCH에서만 갱신·교체하며, 후기 DELETE 트랜잭션에서 연결 행을 삭제한다.'
}

// ------------------------------------------------------------- 실거주 후기
Table reviews {
  id                 integer [pk, increment, not null]
  user_id            integer [not null, note: '작성자 users.id. 수정·삭제 권한 판정 기준 (REQ-FUNC-013, REQ-FUNC-014)']
  region_code        text    [not null, note: '후기 대상 regions.code (REQ-FUNC-012, REQ-FUNC-013, REQ-FUNC-014)']
  destination_id     integer [not null, note: 'destinations.id. 통근 목적지는 후기 생성 시 필수이며 전용 snapshot을 참조한다 (REQ-FUNC-012, REQ-FUNC-013)']
  residence_months  integer [not null, note: '거주 기간(개월), 1..600 (REQ-FUNC-013)']
  felt_commute_min   integer [note: '체감 통근시간(분), 선택 입력 0..240. 이 컬럼은 nullable이 기본 동작이며 값이 없으면 NULL이다. 명시적 nullable 설정은 사용하지 않는다 (REQ-FUNC-012, REQ-FUNC-013)']
  rating_safety      integer [not null, note: '치안 평점 1..5 (REQ-FUNC-012, REQ-FUNC-013)']
  rating_price       integer [not null, note: '가격 평점 1..5 (REQ-FUNC-012, REQ-FUNC-013)']
  rating_convenience integer [not null, note: '생활편의 평점 1..5 (REQ-FUNC-012, REQ-FUNC-013)']
  body               text    [not null, note: '후기 본문 20..1000자 (REQ-FUNC-012, REQ-FUNC-013)']
  created_at         text    [not null, default: `CURRENT_TIMESTAMP`, note: '후기 생성 시각. 최신순 정렬 기준 (REQ-FUNC-012)']
  updated_at         text    [not null, default: `CURRENT_TIMESTAMP`, note: '생성 시각과 같게 시작하고 PATCH 때 API가 갱신 (REQ-FUNC-012, REQ-FUNC-014)']

  indexes {
    (user_id, region_code) [unique, name: 'uq_reviews_user_region']
    (region_code, created_at, id) [name: 'idx_reviews_region_created']
    (destination_id) [unique, name: 'uq_reviews_destination']
  }

  Note: 'UNIQUE(user_id, region_code)는 회원 1명당 행정동별 후기 1건을 보장한다(중복 작성은 409). UNIQUE(destination_id)는 하나의 전용 destination snapshot이 최대 한 후기에서만 참조되도록 한다. API는 작성자 소유권을 확인한 뒤 PATCH에서 현재 snapshot을 갱신하거나 새 snapshot으로 교체하고, DELETE에서 review_helpfuls cascade와 연결 destination 삭제를 같은 트랜잭션으로 수행한다. destination FK에는 자동 cascade를 두지 않는다. API 응답의 destination.name↔place_name, residenceMonths↔residence_months, feltCommuteMin↔felt_commute_min, ratings 3종↔rating_* 매핑을 사용한다. helpfulCount/helpfulByMe/isMine은 각각 COUNT(*), 현재 세션 반응 존재 여부, 소유권 비교로 계산하며 컬럼을 추가하지 않는다. helpful_count를 중복 저장하지 않는다. 후기의 평점·본문은 등급/추천 점수 계산에 사용하지 않는다.'
}

// ------------------------------------------------------------- 후기 도움돼요 반응
Table review_helpfuls {
  review_id  integer [not null, note: 'reviews.id. 후기 삭제 시 CASCADE (REQ-FUNC-015)']
  user_id    integer [not null, note: '도움돼요를 누른 users.id. 회원 1인 1회 (REQ-FUNC-015)']
  created_at text    [not null, default: `CURRENT_TIMESTAMP`, note: '도움돼요 등록 시각']

  indexes {
    (review_id, user_id) [pk, name: 'pk_review_helpfuls']
    (user_id, review_id) [name: 'idx_review_helpfuls_user_review']
  }

  Note: '복합 PK(review_id, user_id)가 중복 등록을 막는다. 후기별 도움돼요 수는 이 테이블을 COUNT(*)로 집계하며 별도 helpful_count/helpfulByMe 컬럼은 두지 않는다. helpfulByMe는 현재 세션 회원의 행 존재 여부로 계산한다 (REQ-FUNC-012, REQ-FUNC-015).'
}

// ------------------------------------------------------------- FK 관계와 삭제 정책
Ref: oauth_accounts.user_id > users.id [delete: cascade]
Ref: sessions.user_id > users.id [delete: cascade]
Ref: reviews.user_id > users.id [delete: cascade]
Ref: reviews.region_code > regions.code
Ref: reviews.destination_id > destinations.id
Ref: review_helpfuls.review_id > reviews.id [delete: cascade]
Ref: review_helpfuls.user_id > users.id [delete: cascade]
